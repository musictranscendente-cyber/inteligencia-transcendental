{
  "expo": {
    "name": "Inteligência Transcendental",
    "slug": "inteligencia-transcendental",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inteligenciatranscendental",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0A1A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transcendental.inteligencia",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Salvar os cards que você quiser compartilhar."
      }
    },
    "android": {
      "package": "com.transcendental.inteligencia",
      "adaptiveIcon": {
        "backgroundColor": "#0B0A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Inteligência Transcendental",
      "shortName": "Transcendental",
      "themeColor": "#0B0A1A",
      "backgroundColor": "#0B0A1A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Salvar os cards que você quiser compartilhar.",
          "savePhotosPermission": "Salvar os cards que você quiser compartilhar.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9B56A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/inteligencia-transcendental"
    },
    "description": "Numerologia, tarô, astrologia, Desenho Humano e mais, cruzados numa só leitura sobre você.",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "877edd5d-8937-4e19-87ac-c69eb85589bd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "transcendente",
    "updates": {
      "url": "https://u.expo.dev/877edd5d-8937-4e19-87ac-c69eb85589bd"
    }
  }
}
